rules_version = '2';
// Regras do Firestore para o app A Maré Vida.
// Só quem estiver logado (Firebase Authentication – atividade A3) lê e grava.
// Enquanto o login em nuvem não estiver pronto, para testar use o "modo de teste"
// do console do Firebase e NUNCA cadastre dados reais de alunos nesse período.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{coll}/{id} {
      allow read, write: if request.auth != null
        && coll in ['sessions', 'students', 'teachers', 'volunteers', 'attendances'];
    }
  }
}
